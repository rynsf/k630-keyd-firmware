diff --git a/src/sino51lib/sh68f90/clock.c b/src/sino51lib/sh68f90/clock.c
index 00c7d8b..57dc055 100644
--- a/src/sino51lib/sh68f90/clock.c
+++ b/src/sino51lib/sh68f90/clock.c
@@ -2,14 +2,27 @@
 #include "sh68f90.h"
 #include "delay.h"
 #include "watchdog.h"
+#ifdef ISP_ENABLE
+#    include "isp.h"
+#endif
+
+// A PLL that never reports lock must not hang the part: give up and enter ISP.
+#define PLL_LOCK_SPINS 60000u
 
 void clock_init()
 {
     CLKCON = _HFON;
     PLLCON = _PLLON;
 
-    while (!(PLLCON & _PLLSTA)) {
+    for (uint16_t spins = 0; !(PLLCON & _PLLSTA); spins++) {
         watchdog_kick();
+        if (spins >= PLL_LOCK_SPINS) {
+#ifdef ISP_ENABLE
+            isp_jump();
+#else
+            break;
+#endif
+        }
     }
 
     PLLCON |= _PLLFS;
